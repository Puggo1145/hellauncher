{
  "name": "hellauncher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "check": "node scripts/check.mjs",
    "test": "CGO_ENABLED=0 go test -race ./...",
    "e2e": "node scripts/e2e/smoke.mjs",
    "build": "mygo build",
    "build:win": "mygo build -platform windows/amd64 -skip-installer",
    "build:all": "mygo build -platform darwin/arm64,windows/amd64 -skip-installer"
  },
  "devDependencies": {
    "mygo-cli": "^0.9.0"
  }
}
