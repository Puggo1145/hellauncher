{
  "name": "helldriver",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "build:win": "mygo build -platform windows/amd64 -skip-installer",
    "build:all": "mygo build -platform darwin/arm64,windows/amd64 -skip-installer",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mygo-runtime": "^0.9.0"
  },
  "devDependencies": {
    "mygo-cli": "^0.9.0",
    "typescript": "^7",
    "vite": "^8"
  }
}
